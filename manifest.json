{
  "manifest_version": 3,
  "name": "Mercor Result Inspector",
  "version": "1.0.0",
  "description": "Copies Mercor Studio result pages (Harbor results / Automation QC) to the clipboard as structured text.",
  "permissions": ["activeTab", "scripting", "clipboardWrite"],
  "action": {
    "default_title": "Mercor Result Inspector",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
